# Copy this file to `.env` and fill in the real values.
# NEVER commit `.env` (it is git-ignored). Keep the service role key secret.

# ─── Supabase Auth / API ──────────────────────────────────────────────────────
# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# SERVER-SIDE ONLY — never exposed to the browser. Used by the Prisma seed to
# create the admin Auth user, and by lib/supabase/admin.ts to mint signed
# upload/read URLs on the private "sinistres" Storage bucket. Set it in Vercel too.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ─── Database (Postgres) ──────────────────────────────────────────────────────
# Supabase Dashboard > "Connect" button > ORMs (Prisma) — copy both strings.
#
# DATABASE_URL = Transaction pooler (pgbouncer, port 6543) — used by the app at
# runtime through the Prisma pg driver adapter.
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL = direct/session connection (port 5432) — used by the Prisma CLI
# for migrations and by the seed. Migrations must NOT go through pgbouncer.
DIRECT_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres"

# ─── Seed overrides (optional) ────────────────────────────────────────────────
# Aucun mot de passe par défaut : si SEED_ADMIN_PASSWORD est vide, le seed en
# génère un fort et l'affiche UNE SEULE FOIS. Les comptes démo sont créés hors
# production uniquement (SEED_DEMO=1 pour forcer). NE PAS commiter de vraie valeur.
# SEED_ADMIN_EMAIL=""
# SEED_ADMIN_PASSWORD=""
# SEED_OUVRIER_EMAIL=""

# ─── Comptes ouvriers ─────────────────────────────────────────────────────────
# Aucune variable : chaque compte ouvrier reçoit un mot de passe propre, tiré au
# hasard côté serveur (lib/ouvrier-acces.ts) et affiché une seule fois.
# SEED_ADMIN_NOM=""
# SEED_DEMO="1"

# ─── TLS base de données (optionnel, recommandé) ──────────────────────────────
# Certificat CA de Supabase (Dashboard > Database > SSL) au format PEM sur une
# ligne. Si fourni, la connexion Postgres vérifie le certificat (anti-MITM).
# Sans lui, la connexion reste chiffrée mais ne vérifie pas le certificat.
# SUPABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# ─── Stripe (abonnement SaaS, facturation mensuelle) ─────────────────────────
# Facultatif : sans ces variables, l'app tourne normalement (organisations
# EXONERE, page Abonnement sans UI de facturation). Deux jeux de clés : mode
# test (sk_test_…) en dev, mode live (sk_live_…) en prod.
#
# STRIPE_SECRET_KEY : SERVER-SIDE ONLY — même règle que SUPABASE_SERVICE_ROLE_KEY.
# Dashboard Stripe > Developers > API keys.
# STRIPE_SECRET_KEY="sk_test_..."
#
# STRIPE_WEBHOOK_SECRET : signature des webhooks (route /api/stripe/webhook).
# En dev : `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# (le whsec_… affiché par la CLI). En prod : Dashboard > Developers > Webhooks,
# événements à écouter : checkout.session.completed, invoice.paid,
# invoice.payment_failed, customer.subscription.deleted.
# STRIPE_WEBHOOK_SECRET="whsec_..."
#
# STRIPE_PRICE_ID : id du tarif mensuel (Dashboard > Product catalog). Le prix
# vit dans Stripe, jamais dans le code — le changer ne demande pas de deploy.
# STRIPE_PRICE_ID="price_..."
